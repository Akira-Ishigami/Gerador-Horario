# Mercado Pago — deixe em branco por enquanto (app funciona 100% mock sem isso)
VITE_MERCADOPAGO_PUBLIC_KEY=

# Supabase — só a URL do projeto e a anon key (pública por design, protegida
# por Row Level Security). NUNCA coloque a service_role/secret key aqui nem
# em nenhuma variável VITE_* — ela é embutida no bundle público do site.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
